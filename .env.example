# Copy to .env.local (never commit it) and fill in.

# The contact form emails messages through Resend (https://resend.com).
# Sign up with ahmadmalik1376@gmail.com, create an API key, and put it here.
# Set the same variable in the Vercel project's Environment Variables.
RESEND_API_KEY=

# Optional, and left out until wanted: a name with nothing after the "="
# is an empty setting, not an absent one, so these stay commented out.

# Who the emails come from. Without it Resend's test sender is used, which
# delivers only to the Resend account's own address. Once a domain is
# verified in Resend, use an address on it:
# CONTACT_FROM=Portfolio <contact@your-domain.com>

# Where the site lives, for the sitemap, robots and shared-link pictures. On
# Vercel the project's own address is used, so this is only for a real domain:
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
